# Copy this file to .env and fill in your real values.
# .env is git-ignored — never commit real credentials.

SCHWAB_CLIENT_ID="YOUR_PENDING_PORTAL_APP_KEY"
SCHWAB_CLIENT_SECRET="YOUR_PENDING_PORTAL_APP_SECRET"
GOOGLE_API_KEY="YOUR_ACTUAL_GEMINI_API_KEY"

# Set to "live" once your Schwab app is approved; keep "paper" while practicing.
TRADING_MODE="paper"

# Comma-separated symbols to watch
WATCH_SYMBOLS="AAPL,TSLA,NVDA"
